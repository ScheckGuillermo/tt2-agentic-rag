# Copiar a .env y completar. Nunca commitear .env.
# cp .env.example .env

# --- LLM (Groq) ---
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# --- Base vectorial (Pinecone) ---
# Índices usados: research-papers, netflix-catalog, user-memory (se crean solos).
PINECONE_API_KEY=

# --- Rutas locales (relativas a la raíz del repo) ---
PAPERS_DIR=data/papers
DATASET_PATH=data/datasets/netflix_titles.csv
MEMORY_DB_PATH=storage/memory.sqlite
