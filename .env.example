# Copiar a .env y completar. Nunca commitear .env.
# cp .env.example .env

# --- Proveedor de LLM y embeddings (pendiente de definir por el equipo) ---
LLM_PROVIDER=
LLM_MODEL=
EMBEDDING_MODEL=
# Clave del proveedor elegido. Algunas integraciones de LangChain esperan un nombre
# específico (por ejemplo OPENAI_API_KEY o GOOGLE_API_KEY); ajustarlo al elegir proveedor.
LLM_API_KEY=

# --- Rutas locales ---
PAPERS_DIR=data/papers
# Ruta al archivo del dataset de Kaggle (definir al elegirlo, ej. data/datasets/<archivo>.csv)
DATASET_PATH=
CHROMA_DIR=storage/chroma
CHROMA_COLLECTION=papers
MEMORY_DB_PATH=storage/memory.sqlite
